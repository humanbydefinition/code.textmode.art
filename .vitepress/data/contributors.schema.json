{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code.textmode.art/schemas/contributors.schema.json",
  "title": "textmode.js ecosystem contributors",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contributors"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "contributors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contributor"
      }
    }
  },
  "$defs": {
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "contributor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["login", "contributions"],
      "properties": {
        "login": {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "profileUrl": {
          "$ref": "#/$defs/httpsUrl"
        },
        "avatarUrl": {
          "$ref": "#/$defs/httpsUrl"
        },
        "contributions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "links": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["icon", "url"],
            "properties": {
              "icon": {
                "enum": [
                  "website",
                  "github",
                  "instagram",
                  "twitter",
                  "mastodon",
                  "bluesky",
                  "discord"
                ]
              },
              "url": {
                "$ref": "#/$defs/httpsUrl"
              }
            }
          }
        }
      }
    }
  }
}
